cabal-version:       3.0
name:                hephaestux
version:             0.1.0.0
author:              Gautier DI FOLCO
maintainer:          foss@difolco.dev
category:            Unclassified
build-type:          Simple
license:             ISC
license-file:        LICENSE
synopsis:            Track coding-agent sessions for tmux
description:         Tracks coding-agent sessions for tmux via agent hooks.
tested-with:         GHC==9.10.3

common shared
  default-language:   Haskell2010
  default-extensions:
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    FlexibleContexts
    GADTs
    GeneralizedNewtypeDeriving
    KindSignatures
    LambdaCase
    OverloadedStrings
    OverloadedRecordDot
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators

library
  import:            shared
  exposed-modules:
    Hephaestux.Agents
    Hephaestux.Cli
    Hephaestux.Commands
    Hephaestux.Install
    Hephaestux.Process
    Hephaestux.Store
    Hephaestux.Style
    Hephaestux.Tmux
    Hephaestux.Types
  hs-source-dirs:    src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
  build-depends:
      base == 4.*
    , aeson
    , bytestring
    , bytestring
    , directory
    , filepath
    , optparse-applicative >= 0.18.1.0 && <0.20
    , process
    , text
    , unix
    , vector

executable hephaestux
  import:            shared
  main-is:           Main.hs
  hs-source-dirs:    app
  ghc-options: -threaded -rtsopts -with-rtsopts=-N -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
  build-depends:
      base == 4.*
    , hephaestux
    , optparse-applicative >= 0.18.1.0 && <0.20

test-suite spec
  import:            shared
  type:              exitcode-stdio-1.0
  main-is:           Spec.hs
  other-modules:
    Hephaestux.InstallSpec
    Hephaestux.ProcessSpec
    Hephaestux.StyleSpec
    Hephaestux.TmuxSpec
    Hephaestux.TypesSpec
  hs-source-dirs:    test
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
  build-depends:
      base == 4.*
    , hephaestux
    , aeson
    , bytestring
    , directory
    , filepath
    , text
    , hspec
    , hspec-discover
